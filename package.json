{
	"name": "supcheckout",
	"version": "0.1.0",
	"private": true,
	"description": "SUPCheckout for UPayments admin UI toolchain. Not part of the distributable plugin; the committed build under assets/admin/build ships instead.",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/SimplixInnovations/supcheckout.git"
	},
	"engines": {
		"node": "24.21.0",
		"npm": "11.19.0"
	},
	"packageManager": "npm@11.19.0",
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "node tools/admin-ui/tokens/build-tokens.mjs && wp-scripts build --config webpack.config.js",
		"build:gallery": "wp-scripts build --config tests/admin-ui/gallery/webpack.gallery.config.cjs",
		"lint:js": "wp-scripts lint-js assets/admin/src tools/admin-ui tests/admin-ui webpack.config.js jest.config.js eslint.config.mjs",
		"lint:css": "wp-scripts lint-style \"assets/admin/src/**/*.css\"",
		"typecheck": "tsc --noEmit --project tsconfig.json && tsc --noEmit --project tsconfig.tests.json",
		"test:unit": "node --experimental-vm-modules node_modules/jest/bin/jest.js --config jest.config.js",
		"test:unit:react19": "node tools/admin-ui/jest/react19.mjs",
		"test:browser": "playwright test --config tests/admin-ui/playwright.config.ts --project=light-ltr --project=dark-ltr --project=light-rtl --project=dark-rtl",
		"test:visual": "playwright test --config tests/admin-ui/playwright.config.ts --project=visual-light-ltr --project=visual-dark-ltr --project=visual-light-rtl --project=visual-dark-rtl",
		"audit:full": "node tools/admin-ui/audit/audit-gate.mjs",
		"audit:lock-age": "node tools/admin-ui/audit/lock-age.mjs",
		"check:drift": "git diff --exit-code -- assets/admin && test -z \"$(git status --porcelain -- assets/admin)\"",
		"quality": "npm run lint:js && npm run lint:css && npm run typecheck && npm run test:unit && npm run build && npm run check:drift"
	},
	"dependencies": {
		"@base-ui/react": "1.8.0",
		"lucide-react": "1.52.0"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.13.0",
		"@fontsource/noto-sans": "5.3.0",
		"@fontsource/noto-sans-arabic": "5.3.0",
		"@fontsource/noto-sans-mono": "5.3.0",
		"@playwright/test": "1.64.1",
		"@testing-library/dom": "10.4.2",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/react": "16.3.3",
		"@testing-library/user-event": "14.6.8",
		"@types/jest": "30.0.0",
		"@types/node": "24.19.2",
		"@types/react": "18.3.31",
		"@types/react-dom": "18.3.7",
		"@wordpress/a11y": "4.57.0",
		"@wordpress/dependency-extraction-webpack-plugin": "6.57.0",
		"@wordpress/dom-ready": "4.57.0",
		"@wordpress/element": "9.0.0",
		"@wordpress/i18n": "6.30.0",
		"@wordpress/scripts": "36.1.0",
		"culori": "4.0.2",
		"globals": "17.13.0",
		"jest": "30.5.2",
		"jest-axe": "11.0.0",
		"jest-environment-jsdom": "30.5.2",
		"postcss": "8.5.30",
		"react": "18.3.1",
		"react-19": "npm:react@19.3.0",
		"react-dom": "18.3.1",
		"react-dom-19": "npm:react-dom@19.3.0",
		"stylelint-use-logical": "2.1.3",
		"typescript": "6.0.3"
	},
	"overrides": {
		"serialize-javascript": "7.1.2",
		"react-dom-19": {
			"react": "$react"
		},
		"markdownlint-cli": {
			"js-yaml": "5.4.1",
			"smol-toml": "1.9.0"
		},
		"micromark-extension-math": {
			"katex": "0.18.2"
		},
		"sockjs": {
			"uuid": "11.1.1"
		},
		"postcss-selector-parser": "7.1.6"
	}
}
