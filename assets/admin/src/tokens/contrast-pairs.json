{
	"$description": "WCAG 2.2 AA pairs checked by tools/admin-ui/tokens/contrast.mjs in light and dark for every core admin color scheme (or the brand accent). kind text needs 4.5:1 (SC 1.4.3), large-text 3:1 (24px or more), non-text 3:1 (SC 1.4.11: control boundaries, focus indicators, meaningful icons). Token names omit the --sup- prefix. A pair may name its use (for example the command palette highlight indicator, an inline-start bar in color-focus-ring on the highlighted row, against the raised dialog surface and the row tint). Every semantic color is either paired or listed in decorative with a reason; every text foreground is paired on every background default text is paired on, or excluded with a reason; every background a control boundary or focus ring can meet is either paired or listed in exclusions with a reason.",
	"decorative": [
		{
			"token": "color-bg-overlay-backdrop",
			"reason": "Translucent scrim behind modal overlays; it carries no information and no text sits on it."
		},
		{
			"token": "color-border-default",
			"reason": "Hairline dividers and card edges that only group content; control boundaries use color-border-strong."
		},
		{
			"token": "color-skeleton-base",
			"reason": "Loading placeholder shape; the loading state is announced as text, not conveyed by the shape's color."
		},
		{
			"token": "color-skeleton-highlight",
			"reason": "Loading shimmer highlight, static under reduced motion; purely decorative."
		}
	],
	"exclusions": [
		{
			"fg": "color-border-strong",
			"bg": [
				"color-status-success-bg",
				"color-status-warning-bg",
				"color-status-danger-bg",
				"color-status-info-bg",
				"color-status-neutral-bg"
			],
			"reason": "Status backgrounds belong to Notices and pills, which carry text, icons and buttons but no bordered form controls; each status uses its own color-status-*-border instead."
		},
		{
			"fg": "color-fg-on-accent",
