{
	"$description": "Contrast-verified accent ramps (palette.accent.50-900) for the nine core WordPress admin color schemes, applied through body.admin-color-<scheme> .supcheckout-admin. The scheme drives the accent only, never the mode. Each ramp is tuned in OKLCH from the scheme source color (same hue): light 600 is the source color when white text on it reaches 4.6:1, otherwise the source darkened to WCAG luminance 0.17; the other steps are luminance targets. Dark ramps target luminance 0.17 at 600 (white text at 4.5:1 and 3:1 against the raised surface), and 900 (the dark accent tint) is the lightest tint on which the dark strong border still reaches 3:1. wpAdminThemeColor records --wp-admin-theme-color at WordPress 7.1.3 (@wordpress/base-styles wordpress-admin-schemes() at the Gutenberg revision pinned by wordpress-develop 7.1.3); a real-WordPress test alarms on drift. brand.tokens.json overrides all of it.",
	"$wpAdminThemeColorDeltas": {
		"$description": "Metadata, never rendered: where another WordPress version in the browser matrix defines a different --wp-admin-theme-color than the WordPress 7.1.3 value recorded in schemes.*.wpAdminThemeColor. Observed in real wp-admin by tests/admin-ui/browser/admin-schemes.spec.ts, which asserts the mismatches equal exactly this list.",
		"6.9.10": {
			"light": "#0085ba",
			"blue": "#096484",
			"coffee": "#46403c",
			"ectoplasm": "#523f6d",
			"midnight": "#e14d43",
			"ocean": "#627c83",
			"sunrise": "#dd823b"
		}
	},
