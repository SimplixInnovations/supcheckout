        - src/Takeover/PausedBoot.php
        - src/Takeover/Preflight.php
        - src/Takeover/Quiesce.php
        - src/Takeover/QuiesceLease.php
        - src/Takeover/ReactivationGuard.php
        - src/Takeover/Rollback.php
        - src/Takeover/RollbackStore.php
        - src/Takeover/RollbackSystem.php
        - src/Takeover/SettingsCopier.php
        - src/Takeover/StaleClaimStore.php
        - src/Takeover/StaleClaims.php
        - src/Takeover/StaleGatewayChoice.php
        - src/Takeover/TakeoverState.php
        - src/Takeover/ThirdPartyTranslator.php
        - src/Takeover/UserMetaCopier.php
        - src/Takeover/WordPressCopyStore.php
        - src/Takeover/WordPressCutoverSystem.php
        - src/Takeover/WordPressStaleClaimStore.php
        - src/Token/CustomerTokenIdentity.php
    tmpDir: .cache/phpstan
services:
    # Private seams reached only through ReflectionMethod by permanent harnesses.
    -
        class: Simplixi\SUPCheckout\Tests\PHPStan\ReflectionSeamMethods
        tags:
            - phpstan.methods.alwaysUsedMethodExtension
