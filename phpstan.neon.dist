parameters:
    level: 5
    phpVersion: 70400
    # A6-06 (hardening batch 6): defensive runtime checks on external or
    # untrusted data stay in the code ("never trust external data", "fail
    # closed"), so PHPDoc types narrow analysis but are not treated as proof.
    treatPhpDocTypesAsCertain: false
    scanFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-stubs.php
        - vendor/php-stubs/woocommerce-stubs/woocommerce-packages-stubs.php
        # Symbols the official stubs lack (WP-CLI, cache-plugin purge APIs, wpdb
        # output constants, runtime-defined plugin constants).
        - tests/phpstan/external-symbols-stubs.php
    # Plugin::load_runtime() sets these at runtime from the main file path; the
    # placeholder values in external-symbols-stubs.php must never be taken as known.
    dynamicConstantNames:
        - SUPCHECKOUT_PLUGIN_URL
        - SUPCHECKOUT_PLUGIN_PATH
    # PHPDoc corrections where the official stubs misstate the runtime contract.
    stubFiles:
        - tests/phpstan/stub-corrections.stub
    # Every src/ PHP file is listed; the static-analysis harness fails when a
    # src/ file is missing from this list.
    paths:
        - src/Account/SubscriptionActions.php
        - src/Admin/AdminAssets.php
        - src/Admin/GatewaySettings.php
        - src/Autoloader.php
        - src/Blocks/PaymentMethodRegistration.php
        - src/Blocks/PaymentMethodType.php
        - src/Bootstrap/BasenameMigration.php
        - src/Bootstrap/Deactivation.php
        - src/Bootstrap/Requirements.php
        - src/Bootstrap/Translations.php
        - src/Bootstrap/WooCommerceDeclarations.php
        - src/Gateway/Availability.php
        - src/Gateway/CheckoutAssets.php
        - src/Gateway/Gateway.php
        - src/Gateway/GatewayRegistration.php
        - src/Gateway/OfficialPluginConflict.php
        - src/Gateway/OrderPresentation.php
        - src/Migration/MigrationAdmin.php
        - src/Migration/MigrationBatch.php
        - src/Migration/MigrationBootstrap.php
        - src/Migration/MigrationCliCommand.php
        - src/Migration/MigrationExecutor.php
        - src/Migration/MigrationPreflight.php
        - src/Migration/MigrationSettings.php
        - src/Payment/CheckoutOrchestrator.php
        - src/Payment/CheckoutPayload.php
        - src/Payment/OrderLock.php
        - src/Payment/PaymentLifecycle.php
        - src/Payment/ProviderErrorSummary.php
        - src/Payment/ProviderResult.php
        - src/Payment/ReconciliationSweep.php
        - src/Payment/SavedCardDisplayCache.php
        - src/Payment/SavedCardPresentation.php
        - src/Payment/SavedCardSelection.php
        - src/Payment/StatusRateGate.php
        - src/Payment/StatusVerifier.php
        - src/Plugin.php
        - src/Provider/EndpointResolver.php
        - src/Provider/MultiMerchantContract.php
        - src/Provider/PaymentMethodAvailability.php
        - src/Release/Identity.php
        - src/Rest/OnboardingController.php
        - src/Rest/RequestGuard.php
        - src/Rest/Responses.php
        - src/Rest/Routes.php
        - src/Rest/SetupController.php
        - src/Security/PublicOrderStatus.php
        - src/Subscription/AutoDeductResultVerifier.php
        - src/Subscription/Checkout/Fields.php
        - src/Subscription/Composition.php
        - src/Subscription/Cron/CycleClaim.php
        - src/Subscription/Cron/Scheduler.php
        - src/Subscription/CycleEconomics.php
        - src/Subscription/Helpers/Utils.php
        - src/Subscription/Presentation.php
        - src/Subscription/ProductTypeHooks.php
        - src/Subscription/RenewalCardAuthority.php
        - src/Subscription/SchedulerBootstrap.php
        - src/Subscription/Scheduling/ActionSchedulerBridge.php
        - src/Subscription/Scheduling/DueParentWorker.php
        - src/Subscription/Scheduling/HistoricalEnrollment.php
        - src/Subscription/Scheduling/LifecycleScheduler.php
        - src/Subscription/WCProductCustomType.php
        - src/Takeover/BackSync.php
        - src/Takeover/BillingTableCopier.php
        - src/Takeover/BudgetedSystem.php
        - src/Takeover/CachePurger.php
        - src/Takeover/Cli.php
        - src/Takeover/CliCommands.php
        - src/Takeover/CopyRemoval.php
        - src/Takeover/CopyRunner.php
        - src/Takeover/CopyStore.php
        - src/Takeover/CronRescheduler.php
        - src/Takeover/Cutover.php
        - src/Takeover/CutoverSystem.php
        - src/Takeover/Environment.php
        - src/Takeover/Finalize.php
        - src/Takeover/FinalizeCommand.php
        - src/Takeover/FinalizeRemoval.php
        - src/Takeover/FinalizeStore.php
        - src/Takeover/Journal.php
        - src/Takeover/JournalReplay.php
