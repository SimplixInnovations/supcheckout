<?xml version="1.0"?>
<ruleset name="SUPCheckout risk-focused foundation">
    <description>Risk-focused WordPress security checks for the first pure-module quality tranche.</description>

    <arg name="extensions" value="php"/>
    <arg name="parallel" value="8"/>
    <config name="installed_paths" value="vendor/wp-coding-standards/wpcs"/>

    <file>src/Payment/CheckoutPayload.php</file>
    <file>src/Payment/OrderLock.php</file>
    <file>src/Payment/ProviderResult.php</file>
    <file>src/Payment/StatusRateGate.php</file>
    <file>src/Payment/StatusVerifier.php</file>
    <file>src/Payment/CheckoutOrchestrator.php</file>
    <file>src/Payment/PaymentLifecycle.php</file>
    <file>src/Provider/EndpointResolver.php</file>
    <file>src/Provider/PaymentMethodAvailability.php</file>
    <file>src/Admin/GatewaySettings.php</file>
    <file>src/Gateway/Availability.php</file>
    <file>src/Gateway/CheckoutAssets.php</file>
    <file>src/Gateway/OrderPresentation.php</file>
    <file>src/Security/PublicOrderStatus.php</file>
    <file>src/Release/Identity.php</file>
    <file>src/Migration/MigrationSettings.php</file>
    <file>src/Migration/MigrationBootstrap.php</file>
    <file>src/Subscription/Composition.php</file>
    <file>src/Subscription/WCProductCustomType.php</file>
    <file>src/Migration/MigrationCliCommand.php</file>
    <file>src/Migration/MigrationAdmin.php</file>
    <file>src/Migration/MigrationPreflight.php</file>
    <file>src/Migration/MigrationBatch.php</file>
    <file>src/Migration/MigrationExecutor.php</file>
    <file>src/Subscription/Presentation.php</file>
    <file>includes/class-wc-gateway-upayments-blocks.php</file>
    <file>includes/Subscription/Checkout/Fields.php</file>
    <file>includes/Subscription/Helpers/Utils.php</file>

    <exclude-pattern>vendor/*</exclude-pattern>

    <rule ref="WordPress.DB.PreparedSQL"/>
    <rule ref="WordPress.PHP.DevelopmentFunctions"/>
    <rule ref="WordPress.Security.EscapeOutput"/>
    <rule ref="WordPress.Security.NonceVerification"/>
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>
</ruleset>
