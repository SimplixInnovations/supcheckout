{
    "name": "simplix-innovations/supcheckout",
    "description": "Development quality toolchain for SUPCheckout for UPayments.",
    "type": "wordpress-plugin",
    "license": "MIT",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.2.13",
        "phpunit/phpunit": "^13.3",
        "squizlabs/php_codesniffer": "^3.13.6",
        "wp-coding-standards/wpcs": "^3.4.1"
    },
    "autoload": {
        "psr-4": {
            "Simplixi\\SUPCheckout\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Simplixi\\SUPCheckout\\Tests\\": "tests/unit/"
        }
    },
    "scripts": {
        "test:unit": "phpunit --configuration phpunit.xml.dist",
        "test:checkout-js": "node tests/harness/e1-classic-subscription-state-harness.js && node tests/harness/e1-classic-place-order-lifecycle-harness.js && node tests/harness/e1-classic-handler-coexistence-harness.js && node tests/harness/e1-blocks-live-props-harness.js && node tests/harness/e3-classic-delayed-script-harness.js",
        "test:ecosystem-analytics-return": "php tests/harness/e3-analytics-return-harness.php",
        "test:http-diagnostics": "bash tests/harness/http-server-diagnostics-harness.sh",
        "analyse": "phpstan analyse --configuration=phpstan.neon.dist --no-progress --memory-limit=512M",
        "lint:phpcs": "phpcs --standard=phpcs.xml.dist",
        "quality": [
            "@test:unit",
            "@test:checkout-js",
            "@test:ecosystem-analytics-return",
            "@test:http-diagnostics",
            "@analyse",
            "@lint:phpcs"
        ]
    },
    "config": {
        "allow-plugins": false,
        "sort-packages": true
    }
}
